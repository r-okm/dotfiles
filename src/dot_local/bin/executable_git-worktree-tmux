#!/usr/bin/env bash
set -euo pipefail

# Files and directories to symlink from original repository to worktree
SYMLINK_TARGETS=(
  '.ignore'
  'CLAUDE.local.md'
  '.claude/settings.local.json'
  '.claude/local'
)

# Set by main(): when true, the tmux session is neither attached nor switched to
DETACH=false
# Set by main(): when true, -r/--remove discards uncommitted changes
FORCE=false

help() {
  cat << EOF
Usage: $(basename "$0") [OPTIONS] [<branch_name|pr_number|branch_suffix|worktree_name|directory>]

Create, list, open, or remove git worktrees, each paired with a tmux session.
The main worktree of a repository can have a tmux session as well (-s).
A new session gets three windows: a shell, nvim, and a shell for Claude.

Options:
  -b, --branch        Create worktree from branch name
  -p, --pull-request  Create worktree from pull request number
  -c, --create-branch Create a new branch from the remote HEAD in a new worktree
                      (branch_suffix is optional)
  -l, --list          List worktrees under .worktree/, one per line as
                      <worktree_name> TAB <branch> TAB <tmux_session|-> TAB
                      <worktree_path>
  -o, --open          Open the tmux session of an existing worktree
  -s, --session       Open the tmux session of the main worktree of the
                      repository at the given directory
  -r, --remove        Remove a worktree and kill its tmux session. The branch is
                      kept. Refuses when the worktree has uncommitted changes,
                      untracked files, or a detached HEAD with commits on no
                      branch, unless -f is given. When the tmux session is
                      the one this runs in, it is not killed but closes once
                      no client is attached to it, unless -f is given.
  -f, --force         With -r, skip the checks above
  -d, --detach        Leave the tmux session detached instead of attaching or
                      switching to it, and print the worktree path (with -s,
                      the main worktree path) on the last line. Use this from
                      non-interactive callers.
  -h, --help          Display this help message

Worktree name: the branch name with '/' replaced by '-'
Worktree path: <repository>/.worktree/<worktree_name>
Session name:  <project_name>+<worktree_name> ('.' replaced by '_'),
               <project_name> for the main worktree

Examples:
  $(basename "$0") -b feature/new-feature
  $(basename "$0") -p 123
  $(basename "$0") -c new-feature
  $(basename "$0") -c
  $(basename "$0") -c new-feature -d
  $(basename "$0") -l
  $(basename "$0") -o feature-new-feature
  $(basename "$0") -r feature-new-feature
  $(basename "$0") -s ~/src/github.com/owner/repo
EOF
}

# Path of the main worktree, so that running this from a linked worktree does not
# nest worktrees under it. The first entry of `worktree list` is the main one.
get_repo_root() {
  git worktree list --porcelain | sed -n '1s/^worktree //p'
}

get_project_name() {
  basename "$(get_repo_root)"
}

# An empty worktree name stands for the main worktree.
# The project name may be passed in to save a lookup per call.
get_session_name() {
  local worktree_name="$1"
  local project_name="${2:-}"
  local session_name

  if [[ -z "$project_name" ]]; then
    project_name=$(get_project_name)
  fi
  session_name="$project_name"
  if [[ -n "$worktree_name" ]]; then
    session_name+="+${worktree_name}"
  fi
  # tmux doesn't allow dots in session names
  echo "${session_name//./_}"
}

# Prints the path of a worktree registered under .worktree/, or fails
resolve_worktree_dir() {
  local worktree_name="$1"
  local worktree_dir

  if [[ -z "$worktree_name" || "$worktree_name" == */* ||
    "$worktree_name" == . || "$worktree_name" == .. ]]; then
    echo "Error: Invalid worktree name: '${worktree_name}'" >&2
    return 1
  fi

  worktree_dir="$(get_repo_root)/.worktree/${worktree_name}"
  if ! git worktree list --porcelain | grep -qxF "worktree ${worktree_dir}"; then
    echo "Error: No such worktree: ${worktree_name} (see -l/--list)" >&2
    return 1
  fi

  echo "$worktree_dir"
}

list_worktrees() {
  local repo_root
  local project_name
  local prefix
  local worktree_name
  local branch
  local worktree_dir
  local session_name
  local session_state

  repo_root=$(get_repo_root)
  project_name=$(basename "$repo_root")
  prefix="${repo_root}/.worktree/"

  git worktree list --porcelain |
    awk -v prefix="$prefix" '
      function flush() {
        name = substr(path, length(prefix) + 1)
        if (index(path, prefix) == 1 && name !~ /\//) print name "\t" branch "\t" path
        path = ""
      }
      /^worktree / { path = substr($0, 10); branch = "(detached)"; next }
      /^branch / { branch = substr($0, 8); sub(/^refs\/heads\//, "", branch); next }
      /^$/ { flush() }
      END { if (path != "") flush() }
    ' |
    while IFS=$'\t' read -r worktree_name branch worktree_dir; do
      session_name=$(get_session_name "$worktree_name" "$project_name")
      session_state="-"
      if tmux has-session -t "=$session_name" 2>/dev/null; then
        session_state="$session_name"
      fi
      printf '%s\t%s\t%s\t%s\n' \
        "$worktree_name" "$branch" "$session_state" "$worktree_dir"
    done
}

open_worktree() {
  local worktree_name="$1"
  local worktree_dir

  worktree_dir=$(resolve_worktree_dir "$worktree_name")
  open_tmux_session "$(get_session_name "$worktree_name")" "$worktree_dir"
}

open_main_worktree() {
  local repo_root

  repo_root=$(get_repo_root)
  open_tmux_session "$(get_session_name "")" "$repo_root"
}

remove_worktree() {
  local worktree_name="$1"
  local worktree_dir
  local session_name
  local changes
  local unreachable
  local remove_args=()

  worktree_dir=$(resolve_worktree_dir "$worktree_name")
  session_name=$(get_session_name "$worktree_name")

  if [[ "$FORCE" != true ]]; then
    # Assigned on its own line so that a failing status aborts under `set -e`
    # instead of reading as a clean worktree
    changes=$(git -C "$worktree_dir" status --porcelain \
      --ignore-submodules=none --untracked-files=normal)
    if [[ -n "$changes" ]]; then
      echo "Error: ${worktree_dir} has uncommitted changes or untracked files" >&2
      echo "Commit or discard them, or pass -f/--force to remove anyway" >&2
      exit 1
    fi

    # A detached HEAD is the only ref to its commits, and it goes with the worktree
    if ! git -C "$worktree_dir" symbolic-ref -q HEAD >/dev/null; then
      unreachable=$(git -C "$worktree_dir" rev-list -n 1 HEAD \
        --not --branches --tags --remotes)
      if [[ -n "$unreachable" ]]; then
        echo "Error: ${worktree_dir} has a detached HEAD with commits on no branch" >&2
        echo "Create a branch for them, or pass -f/--force to remove anyway" >&2
        exit 1
      fi
    fi
  fi

  # git refuses a worktree with initialized submodules unless forced, even when
  # it is clean. The status check above already covers their changes.
  if [[ "$FORCE" == true ||
    -d "$(git -C "$worktree_dir" rev-parse --absolute-git-dir)/modules" ]]; then
    remove_args+=(--force)
  fi

  echo "Removing worktree: ${worktree_dir}"
  git worktree remove "${remove_args[@]}" "$worktree_dir"

  if ! tmux has-session -t "=$session_name" 2>/dev/null; then
    return 0
  fi
  # Without -f, defer killing the session this runs in until the user leaves
  # it: an agent removing its own worktree would otherwise kill itself before
  # its report is read. With -f, the caller asked for it.
  if [[ "$FORCE" != true && -n "${TMUX:-}" &&
    "$(tmux display-message -p '#S')" == "$session_name" ]]; then
    # set-option and set-hook take a pane target, where an exact session
    # match needs the trailing colon
    local target="=${session_name}:"
    local hook
    # destroy-unattached on a session with no client kills it at once, so an
    # unattached one gets it only when a client next enters it
    if [[ -n "$(tmux list-clients -t "$target")" ]]; then
      tmux set-option -t "$target" destroy-unattached on
      echo "Deferred tmux session: ${session_name} (it is the current session; it closes when you leave it)"
    else
      for hook in client-attached client-session-changed; do
        tmux set-hook -t "$target" "$hook" 'set-option destroy-unattached on'
      done
      echo "Deferred tmux session: ${session_name} (it is the current session and no client is on it; it closes after you enter and leave it)"
    fi
    return 0
  fi
  echo "Killing tmux session: ${session_name}"
  tmux kill-session -t "=$session_name"
}

create_symlinks() {
  local worktree_dir="$1"
  local original_repo
  original_repo=$(get_repo_root)

  for target_name in "${SYMLINK_TARGETS[@]}"; do
    local source_path="${original_repo}/${target_name}"
    local target_link="${worktree_dir}/${target_name}"

    if [[ -e "$source_path" && ! -e "$target_link" ]]; then
      # Create parent directory if it doesn't exist
      local parent_dir
      parent_dir=$(dirname "$target_link")
      if [[ ! -d "$parent_dir" ]]; then
        echo "Creating directory: $parent_dir"
        mkdir -p "$parent_dir"
      fi

      echo "Creating symlink: $target_link -> $source_path"
      ln -s "$source_path" "$target_link"
    fi
  done
}

# Blobless instead of shallow: a submodule is usually pinned to a commit behind
# the branch tip, and a shallow fetch of an unadvertised object is refused by
# some servers. Servers without partial clone support just fall back to a full
# fetch, which is slow but not broken.
init_submodules() {
  local worktree_dir="$1"

  [[ -f "${worktree_dir}/.gitmodules" ]] || return 0

  echo "Initializing submodules..."
  git -C "$worktree_dir" submodule update --init --recursive \
    --filter=blob:none ||
    echo "Warning: submodule update failed" >&2
}

create_worktree() {
  local branch="$1"
  # When given, the branch is created at this point instead of being checked out
  local start_point="${2:-}"
  local worktree_name="${branch//\//-}"
  local session_name
  local worktree_dir

  session_name=$(get_session_name "$worktree_name")
  worktree_dir="$(get_repo_root)/.worktree/${worktree_name}"

  if [[ -d "$worktree_dir" ]]; then
    echo "Worktree directory already exists: $worktree_dir"
  else
    echo "Fetching..."
    git fetch || echo "Warning: git fetch failed, continuing with local refs" >&2

    echo "Creating worktree: $worktree_dir"
    if [[ -n "$start_point" ]]; then
      git worktree add --no-track -b "$branch" "$worktree_dir" "$start_point"
    else
      git worktree add "$worktree_dir" "$branch"
    fi
    create_symlinks "$worktree_dir"
    init_submodules "$worktree_dir"
  fi

  open_tmux_session "$session_name" "$worktree_dir"
}

resolve_branch_from_pr() {
  local pr_number="$1"
  gh pr view "$pr_number" --json headRefName --jq '.headRefName'
}

resolve_new_branch_name() {
  local suffix="${1:-wip-$(date +%s)}"
  local user_name

  user_name=$(git config user.name || true)
  if [[ -z "$user_name" ]]; then
    echo "Error: git config user.name is not set" >&2
    exit 1
  fi

  echo "${user_name}/${suffix}"
}

# Window layout of a new session: 1 a free shell, 2 nvim (started from a shell
# so that :q leaves one behind), 3 a shell for Claude. Window 1 stays current.
# ~/.claude/r-okm/scripts/nvim-open.sh relies on nvim being in window 2.
create_tmux_session() {
  local session_name="$1"
  local worktree_dir="$2"
  local nvim_window

  tmux new-session -d -s "$session_name" -c "$worktree_dir"
  # A bare `session:` target takes the next free index
  nvim_window=$(tmux new-window -d -P -F '#{window_id}' \
    -t "=${session_name}:" -c "$worktree_dir")
  tmux send-keys -t "$nvim_window" nvim Enter
  tmux new-window -d -t "=${session_name}:" -c "$worktree_dir"
}

open_tmux_session() {
  local session_name="$1"
  local worktree_dir="$2"
  local created=false

  # `=` forces an exact match: a bare -t target also matches by prefix, which
  # would treat an unrelated session as this one
  if ! tmux has-session -t "=$session_name" 2>/dev/null; then
    create_tmux_session "$session_name" "$worktree_dir"
    created=true
  fi

  if [[ "$DETACH" == true ]]; then
    if [[ "$created" == true ]]; then
      echo "Session created (detached): $session_name"
    else
      echo "Session already exists: $session_name"
    fi
    # Last line of stdout, so non-interactive callers can pick up the path
    echo "$worktree_dir"
  elif [[ -z "${TMUX:-}" ]]; then
    tmux attach-session -t "=$session_name"
  else
    tmux switch-client -t "=$session_name"
  fi
}

main() {
  local mode=""
  local target=""
  local new_branch=""
  local base_ref=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -b|--branch)
        mode="branch"
        shift
        ;;
      -p|--pull-request)
        mode="pr"
        shift
        ;;
      -c|--create-branch)
        mode="create"
        shift
        ;;
      -l|--list)
        mode="list"
        shift
        ;;
      -o|--open)
        mode="open"
        shift
        ;;
      -s|--session)
        mode="session"
        shift
        ;;
      -r|--remove)
        mode="remove"
        shift
        ;;
      -f|--force)
        FORCE=true
        shift
        ;;
      -d|--detach)
        DETACH=true
        shift
        ;;
      -h|--help)
        help
        exit 0
        ;;
      -*)
        echo "Unknown option: $1" >&2
        help
        exit 1
        ;;
      *)
        target="$1"
        shift
        ;;
    esac
  done

  if [[ -z "$mode" ]]; then
    echo "Error: Please specify one of -b, -p, -c, -l, -o, -s or -r" >&2
    help
    exit 1
  fi

  if [[ "$FORCE" == true && "$mode" != "remove" ]]; then
    echo "Error: -f/--force only applies to -r/--remove" >&2
    exit 1
  fi

  # -c/--create-branch may omit the target: it falls back to a generated name
  if [[ -z "$target" && "$mode" != "create" && "$mode" != "list" ]]; then
    echo "Error: Please specify a branch name, PR number, worktree name or directory" >&2
    help
    exit 1
  fi

  # The repository is the one at the given directory, not the current one
  if [[ "$mode" == "session" ]]; then
    cd "$target"
  fi

  # Verify we're in a git repository
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "Error: Not in a git repository" >&2
    exit 1
  fi

  case "$mode" in
    branch)
      create_worktree "$target"
      ;;
    pr)
      echo "Fetching PR #${target} info..."
      create_worktree "$(resolve_branch_from_pr "$target")"
      ;;
    create)
      # Assign first so `set -e` aborts before the worktree is created
      new_branch=$(resolve_new_branch_name "$target")
      base_ref=$(git symbolic-ref refs/remotes/origin/HEAD)
      create_worktree "$new_branch" "$base_ref"
      ;;
    list)
      list_worktrees
      ;;
    open)
      open_worktree "$target"
      ;;
    remove)
      remove_worktree "$target"
      ;;
    session)
      open_main_worktree
      ;;
  esac
}

main "$@"

# vim: set ft=sh:
