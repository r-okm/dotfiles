#!/usr/bin/env bash
set -euo pipefail

# Files and directories to symlink from original repository to worktree
SYMLINK_TARGETS=(
  '.ignore'
  'CLAUDE.local.md'
  '.claude/settings.local.json'
  '.claude/local'
)

# Set by main(): when true, the tmux session is neither attached nor switched to
DETACH=false

help() {
  cat << EOF
Usage: $(basename "$0") [OPTIONS] [<branch_name|pr_number|branch_suffix>]

Create a git worktree and open it in a new tmux session.

Options:
  -b, --branch        Create worktree from branch name
  -p, --pull-request  Create worktree from pull request number
  -c, --create-branch Create a new branch from the remote HEAD in a new worktree
                      (branch_suffix is optional)
  -d, --detach        Leave the tmux session detached instead of attaching or
                      switching to it, and print the worktree path on the last
                      line. Use this from non-interactive callers.
  -h, --help          Display this help message

Session name format: <project_name>+<branch_name|pr_number>
Worktree is created in .worktree/ subdirectory of the repository.

Examples:
  $(basename "$0") -b feature/new-feature
  $(basename "$0") -p 123
  $(basename "$0") -c new-feature
  $(basename "$0") -c
  $(basename "$0") -c new-feature -d
EOF
}

# Path of the main worktree, so that running this from a linked worktree does not
# nest worktrees under it. The first entry of `worktree list` is the main one.
get_repo_root() {
  git worktree list --porcelain | sed -n '1s/^worktree //p'
}

get_project_name() {
  basename "$(get_repo_root)"
}

create_symlinks() {
  local worktree_dir="$1"
  local original_repo
  original_repo=$(get_repo_root)

  for target_name in "${SYMLINK_TARGETS[@]}"; do
    local source_path="${original_repo}/${target_name}"
    local target_link="${worktree_dir}/${target_name}"

    if [[ -e "$source_path" && ! -e "$target_link" ]]; then
      # Create parent directory if it doesn't exist
      local parent_dir
      parent_dir=$(dirname "$target_link")
      if [[ ! -d "$parent_dir" ]]; then
        echo "Creating directory: $parent_dir"
        mkdir -p "$parent_dir"
      fi

      echo "Creating symlink: $target_link -> $source_path"
      ln -s "$source_path" "$target_link"
    fi
  done
}

# Blobless instead of shallow: a submodule is usually pinned to a commit behind
# the branch tip, and a shallow fetch of an unadvertised object is refused by
# some servers. Servers without partial clone support just fall back to a full
# fetch, which is slow but not broken.
init_submodules() {
  local worktree_dir="$1"

  [[ -f "${worktree_dir}/.gitmodules" ]] || return 0

  echo "Initializing submodules..."
  git -C "$worktree_dir" submodule update --init --recursive \
    --filter=blob:none ||
    echo "Warning: submodule update failed" >&2
}

create_worktree() {
  local branch="$1"
  # When given, the branch is created at this point instead of being checked out
  local start_point="${2:-}"
  local project_name
  local session_name
  local worktree_dir

  project_name=$(get_project_name)
  session_name="${project_name}+${branch//\//-}"
  worktree_dir="$(get_repo_root)/.worktree/${branch//\//-}"

  if [[ -d "$worktree_dir" ]]; then
    echo "Worktree directory already exists: $worktree_dir"
  else
    echo "Fetching..."
    git fetch

    echo "Creating worktree: $worktree_dir"
    if [[ -n "$start_point" ]]; then
      git worktree add --no-track -b "$branch" "$worktree_dir" "$start_point"
    else
      git worktree add "$worktree_dir" "$branch"
    fi
    create_symlinks "$worktree_dir"
    init_submodules "$worktree_dir"
  fi

  open_tmux_session "$session_name" "$worktree_dir"

  # Last line of stdout, so non-interactive callers can pick up the path
  if [[ "$DETACH" == true ]]; then
    echo "$worktree_dir"
  fi
}

resolve_branch_from_pr() {
  local pr_number="$1"
  gh pr view "$pr_number" --json headRefName --jq '.headRefName'
}

resolve_new_branch_name() {
  local suffix="${1:-wip-$(date +%s)}"
  local user_name

  user_name=$(git config user.name || true)
  if [[ -z "$user_name" ]]; then
    echo "Error: git config user.name is not set" >&2
    exit 1
  fi

  echo "${user_name}/${suffix}"
}

open_tmux_session() {
  local session_name="$1"
  local worktree_dir="$2"

  # Replace dots with underscores (tmux doesn't allow dots in session names)
  session_name="${session_name//./_}"

  # `=` forces an exact match: a bare -t target also matches by prefix, which
  # would treat an unrelated session as this one
  if [[ "$DETACH" == true ]]; then
    if tmux has-session -t "=$session_name" 2>/dev/null; then
      echo "Session already exists: $session_name"
    else
      tmux new-session -d -s "$session_name" -c "$worktree_dir"
      echo "Session created (detached): $session_name"
    fi
  elif [[ -z "${TMUX:-}" ]]; then
    # Outside tmux: create a new session or attach to an existing one
    tmux new-session -s "$session_name" -c "$worktree_dir" 2>/dev/null ||
      tmux attach-session -t "$session_name"
  else
    # Inside tmux: create a new session and switch to it
    if tmux has-session -t "=$session_name" 2>/dev/null; then
      tmux switch-client -t "$session_name"
    else
      tmux new-session -d -s "$session_name" -c "$worktree_dir"
      tmux switch-client -t "$session_name"
    fi
  fi
}

main() {
  local mode=""
  local target=""
  local new_branch=""
  local base_ref=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -b|--branch)
        mode="branch"
        shift
        ;;
      -p|--pull-request)
        mode="pr"
        shift
        ;;
      -c|--create-branch)
        mode="create"
        shift
        ;;
      -d|--detach)
        DETACH=true
        shift
        ;;
      -h|--help)
        help
        exit 0
        ;;
      -*)
        echo "Unknown option: $1" >&2
        help
        exit 1
        ;;
      *)
        target="$1"
        shift
        ;;
    esac
  done

  if [[ -z "$mode" ]]; then
    echo "Error: Please specify -b/--branch, -p/--pull-request or -c/--create-branch" >&2
    help
    exit 1
  fi

  # -c/--create-branch may omit the target: it falls back to a generated name
  if [[ -z "$target" && "$mode" != "create" ]]; then
    echo "Error: Please specify a branch name or PR number" >&2
    help
    exit 1
  fi

  # Verify we're in a git repository
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "Error: Not in a git repository" >&2
    exit 1
  fi

  case "$mode" in
    branch)
      create_worktree "$target"
      ;;
    pr)
      echo "Fetching PR #${target} info..."
      create_worktree "$(resolve_branch_from_pr "$target")"
      ;;
    create)
      # Assign first so `set -e` aborts before the worktree is created
      new_branch=$(resolve_new_branch_name "$target")
      base_ref=$(git symbolic-ref refs/remotes/origin/HEAD)
      create_worktree "$new_branch" "$base_ref"
      ;;
  esac
}

main "$@"

# vim: set ft=sh:
