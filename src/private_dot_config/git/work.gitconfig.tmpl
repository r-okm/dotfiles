# vim: set ft=conf:
# vim: set noexpandtab:

[core]
	sshCommand = {{ if eq .chezmoi.os "windows" }}C:/Windows/System32/OpenSSH/ssh.exe{{ else }}ssh{{ end }} -i {{ .chezmoi.homeDir }}/.ssh/keypair/git/id_gh_work.pub -o IdentitiesOnly=yes -F none
[user]
	name = {{ .work.git_user_name }}
	email = {{ .work.git_user_email }}
[commit]
	gpgsign = false
{{- with get .work "github_user" }}
# `gh auth git-credential` answers with the active account only, so pin the
# work account's token. && fails closed instead of falling back to the active
# account; </dev/null keeps gh.exe (via the WSL wrapper) off git's stdin.
[credential "https://github.com"]
	helper =
	helper = !token=$(gh auth token --hostname github.com --user {{ . }} </dev/null) && GH_TOKEN=$token gh auth git-credential
{{- end }}
