# vim: set ft=conf:
# vim: set noexpandtab:

[core]
	sshCommand = {{ if eq .chezmoi.os "windows" }}C:/Windows/System32/OpenSSH/ssh.exe{{ else }}ssh{{ end }} -i {{ .chezmoi.homeDir }}/.ssh/keypair/git/id_gh_work.pub -o IdentitiesOnly=yes -F none
[user]
	name = {{ .work.git_user_name }}
	email = {{ .work.git_user_email }}
[commit]
	gpgsign = false
