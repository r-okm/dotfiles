{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Read(~/.claude/**)",
      "Read(~/.config/zsh/completions/**)",
      "Read(~/work/**)",
      "Read(~/.config/tmux/plugins/**)",
      "Read(//tmp/**)",
      "Read(~/.cache/ss/**)",
      "Read(~/.local/state/yt-summary/**)",
      "Edit(~/.local/state/yt-summary/**)",
      "WebSearch"
    ],
    "deny": [
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.config/gh/**)",
      "Edit(//mnt/**)",
      "Bash(printenv*)",
      "Bash(export *)",
      "Bash(set *)",
      "Bash(cat /proc*)",
      "Bash(sudo *)",
      "Bash(git push *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform state rm *)",
      "Bash(terraform state mv *)",
      "Bash(terraform state push *)",
      "Bash(terraform state replace-provider *)",
      "Bash(terraform import *)",
      "Bash(terraform force-unlock *)",
      "Bash(terraform workspace delete *)",
      "Bash(terraform taint *)",
      "Bash(terraform untaint *)",
      "Bash(terraform refresh *)",
      "Bash(terraform login *)",
      "Bash(terraform logout *)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Edit(~/.claude/r-okm/scripts/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(//mnt/**)",
      "Read(//proc/**)"
    ],
    "additionalDirectories": [
      "~/src/github.com/r-okm/project-ignores"
    ]
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "deep-research": "user-invocable-only"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|auth_success|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/r-okm/scripts/notify-claude-activity.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/r-okm/scripts/notify-claude-activity.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/r-okm/scripts/log-permission-request.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/r-okm/scripts/statusline-command.sh"
  },
  "enabledPlugins": {
    "compact-plus@compact-plus-local": true,
    "review-wizard@review-wizard-marketplace": true
  },
  "extraKnownMarketplaces": {
    "compact-plus-local": {
      "source": {
        "source": "github",
        "repo": "u-ichi/compact-plus"
      }
    },
    "review-wizard-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/uehaj/review-wizard.git"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "registry.npmjs.org"
      ],
      "tlsTerminate": {}
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/ss",
        "~/.config/chezmoi"
      ],
      "denyRead": [
        "~/.ssh",
        "/mnt"
      ],
      "allowRead": [
        "~/.config/gh/config.yml"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "mask",
          "extract": "oauth_token:\\s*(\\S+)",
          "injectHosts": [
            "api.github.com",
            "github.com"
          ]
        }
      ]
    },
    "excludedCommands": [
      "git:*",
      "tmux:*",
      "git-worktree-tmux:*",
      "explorer:*",
      "xdg-open:*",
      "docker:*",
      "~/.claude/r-okm/scripts/*",
      "node *review-wizard-marketplace/review-wizard/*/scripts/review_wizard.ts*"
    ]
  },
  "effortLevel": "high",
  "advisorModel": "fable",
  "autoUpdatesChannel": "latest",
  "plansDirectory": "./.ignore/ai/plans",
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true
}
