" buftabline only handles tabline clicks via 'tablineat', which is Neovim-only,
" so map the clicked column back to a buffer from its rendered labels.
function! s:TablineBufAt(col) abort
  let segs = split(buftabline#render(), '%#BufTabLine')[1:]
  call filter(segs, 'v:val !~# "^Fill#"')
  let bufs = buftabline#user_buffers()
  " Overflowing labels are dropped from both ends; anchor on the current one.
  let cur = match(segs, '^Current#')
  let offset = len(segs) == len(bufs) ? 0
        \ : cur >= 0 ? index(bufs, bufnr('%')) - cur : -1
  if offset < 0
    return 0
  endif
  let right = 0
  for i in range(len(segs))
    let label = substitute(matchstr(segs[i], '#\zs.*'), '%%', '%', 'g')
    let right += strdisplaywidth(label)
    if a:col <= right
      return get(bufs, offset + i, 0)
    endif
  endfor
  return 0
endfunction

" Run {cmd} on the clicked buffer, or pass {key} through outside the tabline.
function! s:OnTablineClick(key, cmd) abort
  let pos = getmousepos()
  if pos.screenrow != 1 || pos.winid != 0 || !exists('*buftabline#render')
    return a:key
  endif
  let buf = s:TablineBufAt(pos.screencol)
  return buf > 0 ? "\<Cmd>" . a:cmd . ' ' . buf . "\<CR>" : ''
endfunction
nnoremap <expr> <LeftMouse> <SID>OnTablineClick("\<LeftMouse>", 'buffer')
nnoremap <expr> <MiddleMouse> <SID>OnTablineClick("\<MiddleMouse>", 'bdelete')
