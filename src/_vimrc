" Like vim-asterisk's gz*: no word boundaries, and the cursor stays put.
" v:hlsearch and v:searchforward are restored when a function returns, so
" they are set in the mapping itself.
function! s:StarPattern(text) abort
  " An empty pattern would match at every position and replace the last search
  if a:text ==# ''
    throw 'E348: No string under cursor'
  endif
  return '\V' . substitute(escape(a:text, '\'), '\n', '\\n', 'g')
endfunction
nnoremap * <Cmd>let @/ = <SID>StarPattern(expand('<cword>'))<Bar>call histadd('/', @/)<Bar>let v:searchforward = 1<Bar>let v:hlsearch = 1<CR>
xnoremap * <Cmd>let @/ = <SID>StarPattern(join(getregion(getpos('v'), getpos('.'), #{type: mode()}), "\n"))<Bar>call histadd('/', @/)<Bar>let v:searchforward = 1<Bar>let v:hlsearch = 1<CR><Esc>

