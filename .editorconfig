# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

# PEP 8; black and ruff format hard-code 4 spaces and take no configuration
[*.py]
indent_size = 4

# windows-sync copies these byte for byte; Windows Terminal writes no final newline
[src/AppData/**]
insert_final_newline = false
